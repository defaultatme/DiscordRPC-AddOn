{
  "manifest_version": 3,
  "name": "SimpleRPC",
  "version": "1.0",
  "description": "Share your current website activity directly to Discord Rich Presence.",
  "browser_specific_settings": {
    "gecko": {
      "id": "simplerpc@local.test",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SimpleRPC"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
